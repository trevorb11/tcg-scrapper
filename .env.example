# Industry Deep Scan Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENVIRONMENT=development  # development, staging, production
LOG_LEVEL=INFO

# =============================================================================
# DATABASE
# =============================================================================
# SQLite (default for development)
DB_DRIVER=sqlite
DB_SQLITE_PATH=data/deep_scan.db

# PostgreSQL (recommended for production)
# DB_DRIVER=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=industry_deep_scan
# DB_USER=postgres
# DB_PASSWORD=your_password

# =============================================================================
# LLM CONFIGURATION
# =============================================================================
# Provider: openai or anthropic
LLM_PROVIDER=openai

# OpenAI
LLM_OPENAI_API_KEY=sk-your-openai-key-here
LLM_OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic (alternative)
# LLM_ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
# LLM_ANTHROPIC_MODEL=claude-3-opus-20240229

# Rate limiting and cost control
LLM_REQUESTS_PER_MINUTE=60
LLM_MAX_COST_PER_DAY=50.00
LLM_CACHE_RESPONSES=true

# =============================================================================
# SOURCE API KEYS
# =============================================================================
# Yelp Fusion API (get at https://www.yelp.com/developers/v3/manage_app)
SOURCE_YELP_API_KEY=your-yelp-api-key
SOURCE_YELP_ENABLED=true

# Google News (free RSS, no API key needed)
SOURCE_GOOGLE_NEWS_ENABLED=true

# BBB (no API key needed)
SOURCE_BBB_ENABLED=true

# Business listings (no API key needed)
SOURCE_BIZBUYSELL_ENABLED=true
SOURCE_BUSINESSBROKER_ENABLED=true

# Court records / liens
SOURCE_COURT_RECORDS_ENABLED=true

# Equipment permits
SOURCE_EQUIPMENT_PERMITS_ENABLED=true

# SOS filings
SOURCE_SOS_FILINGS_ENABLED=true

# LinkedIn (requires manual import or API partnership)
SOURCE_LINKEDIN_ENABLED=false
# SOURCE_LINKEDIN_COOKIE=your-linkedin-li_at-cookie

# =============================================================================
# SCRAPING CONFIGURATION
# =============================================================================
SCRAPE_TIMEOUT=30
SCRAPE_MAX_RETRIES=3
SCRAPE_REQUESTS_PER_SECOND=0.5
SCRAPE_CONCURRENT_REQUESTS=5
SCRAPE_USE_PLAYWRIGHT=true
SCRAPE_HEADLESS=true

# Target states (comma-separated)
SCRAPE_TARGET_STATES=CA,TX,FL,NY,IL,PA,OH,GA,NC,MI

# =============================================================================
# NOTIFICATIONS
# =============================================================================
# Slack (get webhook URL from Slack App settings)
NOTIFY_SLACK_ENABLED=false
NOTIFY_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
NOTIFY_SLACK_CHANNEL=#mca-leads

# Email via SendGrid
NOTIFY_EMAIL_ENABLED=false
NOTIFY_SENDGRID_API_KEY=SG.your-sendgrid-key
NOTIFY_EMAIL_FROM=alerts@yourbrokerage.com
NOTIFY_EMAIL_RECIPIENTS=sales@yourbrokerage.com,manager@yourbrokerage.com

# Webhook for CRM integration
NOTIFY_WEBHOOK_ENABLED=false
NOTIFY_WEBHOOK_URL=https://your-crm.com/webhook/leads
NOTIFY_WEBHOOK_SECRET=your-webhook-secret

# Alert thresholds
NOTIFY_MIN_PRIORITY_FOR_INSTANT_ALERT=8
NOTIFY_DAILY_DIGEST_ENABLED=true
NOTIFY_DAILY_DIGEST_HOUR=8

# =============================================================================
# SCHEDULER
# =============================================================================
# Scan intervals (in minutes)
SCHEDULER_NEWS_SCAN_INTERVAL=30
SCHEDULER_REVIEW_SCAN_INTERVAL=120
SCHEDULER_BBB_SCAN_INTERVAL=360
SCHEDULER_LISTINGS_SCAN_INTERVAL=60
SCHEDULER_LIENS_SCAN_INTERVAL=720
SCHEDULER_PERMITS_SCAN_INTERVAL=720

# Celery (for production distributed scanning)
# SCHEDULER_CELERY_BROKER=redis://localhost:6379/0
# SCHEDULER_CELERY_BACKEND=redis://localhost:6379/1

# =============================================================================
# API SERVER
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# API authentication (comma-separated list of valid keys)
API_API_KEY_ENABLED=true
API_API_KEYS=your-api-key-1,your-api-key-2

# CORS (comma-separated origins)
API_CORS_ORIGINS=*
API_RATE_LIMIT_PER_MINUTE=100

# =============================================================================
# LEAD SCORING
# =============================================================================
SCORING_WEIGHT_CASH_SQUEEZE=9.0
SCORING_WEIGHT_RAPID_GROWTH=8.0
SCORING_WEIGHT_DISTRESS=7.0
SCORING_MIN_ESTIMATED_REVENUE=100000
